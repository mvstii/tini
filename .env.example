# Tını ortam değişkenleri şablonu
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env asla depoya eklenmez.

# Veritabanı
DATABASE_URL=

# Uygulama
APP_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Spotify (Development Mode, en fazla 5 kullanıcı)
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=

# Keşif kaynakları
LASTFM_API_KEY=
LISTENBRAINZ_TOKEN=
MUSICBRAINZ_USER_AGENT=

# Apple Music (Faz 7)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
