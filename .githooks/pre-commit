#!/usr/bin/env bash
# Commit öncesi sızıntı taraması: yalnızca staged değişiklikleri gitleaks ile tarar.
# gitleaks yoksa uyarır ve geçer (kurulum.ps1 -Extra kurar); bulgu varsa commit'i durdurur.
# Bulgular --redact ile maskelenir; değerler terminale yazılmaz.

if ! command -v gitleaks > /dev/null 2>&1; then
  echo "⚠️ [PRE-COMMIT]: gitleaks bulunamadı, sızıntı taraması ATLANDI. 'kurulum.ps1 -Extra' ile kurun." >&2
  exit 0
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1; then
  echo "🚫 [PRE-COMMIT]: Olası gizli bilgi bulundu, commit durduruldu. Bulguyu kaldırın; yanlış alarmsa .gitleaksignore kullanın." >&2
  exit 1
fi
exit 0
